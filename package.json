{
  "name": "revline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "deploy:production": "node scripts/deploy-production.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "next dev --hostname localhost --port 3001",
    "build": "next build",
    "start": "next start --hostname localhost",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "smoke": "fail=; log=$(mktemp); for f in scripts/*-smoke.mjs scripts/*-smoke.ts; do case \"${f#scripts/}\" in agentic-video-*|claude-model-*|frame-inspection-*|video-import-*|music-beats-*|assistant-mobile-layout-*|preview-immediate-resume-*|preview-playback-smoothness-*) continue;; esac; grep -q 'localhost:3001\\|storage.googleapis.com' \"$f\" && continue; if timeout 300 node --import tsx \"$f\" > \"$log\" 2>&1; then echo \"PASS $f\"; else cat \"$log\"; echo \"FAIL $f\"; fail=\"$fail $f\"; fi; done; rm -f \"$log\"; [ -z \"$fail\" ] || { echo \"Failed smoke checks:$fail\"; exit 1; }",
    "postinstall": "node scripts/copy-vendor.mjs",
    "convex:dev": "convex dev",
    "worker": "node --env-file=.env.local --import tsx scripts/media-worker.ts",
    "worker:production": "node --env-file=.env.production.local --import tsx scripts/media-worker.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "build:cloudflare": "node scripts/cloudflare-frontend.mjs build",
    "preview:cloudflare": "node scripts/cloudflare-frontend.mjs preview",
    "deploy:frontend": "node scripts/cloudflare-frontend.mjs deploy",
    "check:setup": "node scripts/check-setup.mjs",
    "deploy:frontend:ci": "npm run build:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "deploy:fly-exports": "node scripts/deploy-fly-exports.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/openai": "^4.0.94",
    "@clerk/backend": "^3.23.2",
    "@clerk/nextjs": "^7.9.14",
    "@clerk/ui": "^1.40.0",
    "@convex-dev/agent": "^0.7.7",
    "@convex-dev/stripe": "^0.1.7",
    "@convex-dev/workflow": "0.4.10",
    "@fal-ai/client": "^1.10.1",
    "@hyperframes/player": "0.8.144",
    "@hyperframes/producer": "0.8.143",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@meta-sam/parser": "0.1.0",
    "@meta-sam/react": "0.1.14",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@remotion/transitions": "4.0.535",
    "@sentry/nextjs": "^11.8.0",
    "@vinext/cloudflare": "^1.1.1",
    "ai": "^7.0.137",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "posthog-js": "^1.438.12",
    "puppeteer": "25.13.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.3",
    "react-server-dom-webpack": "^19.3.1",
    "remotion": "4.0.535",
    "stripe": "^22.6.2",
    "sucrase": "3.35.1",
    "vinext": "^1.2.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "convex-test": "^0.0.61",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "type": "module"
}
