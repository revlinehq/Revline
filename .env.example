# Provision development keys with: npx clerk init
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Configure with: npx convex dev
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Set this on the Convex deployment with `npx convex env set`.
CLERK_JWT_ISSUER_DOMAIN=

# AI editing: set on the Convex deployment. Optional, inactive until configured.
ANTHROPIC_API_KEY=
# Alternative on an eligible paid Convex team; leave disabled until activation.
AI_GATEWAY_ENABLED=false

# Media analysis: background Node worker only. Optional; never NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
# Native video understanding and targeted inspection use agentic processing.
# Google currently routes the requested 3.7 ID to 3.8; no forced static FPS.
GEMINI_VIDEO_MODEL=gemini-3.7-flash
# CPU music tracker executable/model; defaults below are configured locally.
BEAT_TRACK_PYTHON=
BEAT_TRACK_MODEL_PATH=
BEAT_TRACK_THREADS=2
# Legacy queued shot tasks only; not part of the AI's current tool list.
SCENE_DETECT_PYTHON=
# Optional custom executable; defaults to .data/video-import/bin/yt-dlp.
YT_DLP_PATH=

# Media worker secret must match the Node worker and Convex; generated locally at setup.
RENDER_WORKER_SECRET=
MEDIA_WORKER_CONCURRENCY=2
# Optional hosted processor wake endpoint; set on its Convex deployment.
# Keep MEDIA_WORKER_URL below pointed at the private R2 media service.
MEDIA_PROCESSOR_WAKE_URL=

# Stripe scaffold: one USD $39/month plan with a 3-day first-subscription trial.
# Keep billing disabled until the product/price and signed webhook are activated.
# Secrets belong on Convex, never in NEXT_PUBLIC_ variables.
BILLING_ENABLED=false
APP_ORIGIN=http://localhost:3001
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Private Cloudflare R2 uploads and signed playback. Set these on Convex as well.
MEDIA_WORKER_URL=
MEDIA_SIGNING_SECRET=
