# Provision development keys with: npx clerk init
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Configure with: npx convex dev
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Set this on the Convex deployment with `npx convex env set`.
CLERK_JWT_ISSUER_DOMAIN=

# AI editing: set on the Convex deployment. Optional, inactive until configured.
ANTHROPIC_API_KEY=
# Alternative on an eligible paid Convex team; leave disabled until activation.
AI_GATEWAY_ENABLED=false

# Media analysis: background Node worker only. Optional; never NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
# Gemini visual analysis is retained only for the comparison script.
GEMINI_VIDEO_MODEL=gemini-3.8-flash
TWELVELABS_API_KEY=
TWELVELABS_VIDEO_MODEL=pegasus1.6
# Optional custom Python executable; defaults to .data/scene-detection/bin/python.
SCENE_DETECT_PYTHON=

# Media worker secret must match the Node worker and Convex; generated locally at setup.
RENDER_WORKER_SECRET=
MEDIA_WORKER_CONCURRENCY=2

# Stripe scaffold: one USD $39/month plan with a 3-day first-subscription trial.
# Keep billing disabled until the product/price and signed webhook are activated.
# Secrets belong on Convex, never in NEXT_PUBLIC_ variables.
BILLING_ENABLED=false
APP_ORIGIN=http://localhost:3001
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Private Cloudflare R2 uploads and signed playback. Set these on Convex as well.
MEDIA_WORKER_URL=
MEDIA_SIGNING_SECRET=
