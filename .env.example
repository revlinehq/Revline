# Provision development keys with: npx clerk init
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Configure with: npx convex dev
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Set this on the Convex deployment with `npx convex env set`.
CLERK_JWT_ISSUER_DOMAIN=

# AI editing: set on the Convex deployment. Optional, inactive until configured.
ANTHROPIC_API_KEY=
# Optional manual Haiku/Sonnet/Opus picker; set on each intended Convex deployment.
MODEL_SWITCHER_ENABLED=false
# Alternative on an eligible paid Convex team; leave disabled until activation.
AI_GATEWAY_ENABLED=false

# Media analysis: background Node worker only. Optional; never NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=
# Local clipping vision and pixel tracking do not require Gemini. Paid fallback is opt-in.
MEDIA_VISION_GEMINI_FALLBACK=false
# fal.ai person/foreground cutouts, RIFE, depth, parallax inpainting and single-frame object grounding. Worker only.
FAL_KEY=
# Speech transcription (Deepgram Nova-3).
DEEPGRAM_API_KEY=
# Native video understanding and targeted inspection use agentic processing.
# Google currently routes the requested 3.7 ID to 3.8; no forced static FPS.
GEMINI_VIDEO_MODEL=gemini-3.7-flash
# CPU music tracker executable/model; defaults below are configured locally.
BEAT_TRACK_PYTHON=
BEAT_TRACK_MODEL_PATH=
BEAT_TRACK_THREADS=2
# Shot detection and pixel tracking share this OpenCV environment.
SCENE_DETECT_PYTHON=
# Optional pixel tracking executable. Falls back to SCENE_DETECT_PYTHON (same OpenCV environment).
PIXEL_TRACK_PYTHON=
# Optional custom executable; defaults to .data/video-import/bin/yt-dlp.
YT_DLP_PATH=

# Media worker secret must match the Node worker and Convex; generated locally at setup.
RENDER_WORKER_SECRET=
MEDIA_WORKER_CONCURRENCY=2
# Processor backend is configured on Convex: local (dev), fly, or cloudflare.
# Fly deployment sets FLY_PROCESSOR_APP, FLY_PROCESSOR_IMAGE and the app-scoped
# FLY_PROCESSOR_API_TOKEN on the matching Convex deployment. Optional Convex
# overrides: FLY_PROCESSOR_CPUS=8, FLY_PROCESSOR_MAX_MACHINES=4, FLY_PROCESSOR_REGION=iad.
# Retained Cloudflare rollback wake endpoint; set on its Convex deployment.
# Keep MEDIA_WORKER_URL below pointed at the private R2 media service.
MEDIA_PROCESSOR_WAKE_URL=

# Stripe scaffold: one USD $39/month plan with a 3-day first-subscription trial.
# Keep billing disabled until the product/price and signed webhook are activated.
# Secrets belong on Convex, never in NEXT_PUBLIC_ variables.
BILLING_ENABLED=false
APP_ORIGIN=http://localhost:3001
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Optional telemetry scaffold. No browser/server events until explicitly enabled.
# These settings belong on the frontend host. NEXT_PUBLIC_ values are bundled.
NEXT_PUBLIC_TELEMETRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional build-only source-map upload token. Never expose in NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
# Use your project's regional ingestion host, e.g. https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=

# Optional Discord alerts: set on each intended Convex deployment, never NEXT_PUBLIC_.
# Missing settings disable delivery. Provider setup details: docs/observability.md.
DISCORD_ALERTS_ENABLED=false
DISCORD_WEBHOOK_URL=
CLERK_WEBHOOK_SIGNING_SECRET=
SENTRY_WEBHOOK_SECRET=
POSTHOG_WEBHOOK_SECRET=

# Private Cloudflare R2 uploads and signed playback. Set these on Convex as well.
MEDIA_WORKER_URL=
MEDIA_SIGNING_SECRET=
