{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "revline-editor-media-production",
  "main": "worker.ts",
  "account_id": "701645e913477e567db69b11343f59d8",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "revline-editor-media" }],
  "vars": { "ALLOWED_ORIGINS": "https://tryrevline.com,https://editor.tryrevline.com" },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
