{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "revline-editor-media",
  "main": "worker.ts",
  "account_id": "701645e913477e567db69b11343f59d8",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "revline-editor-media" }],
  "vars": { "ALLOWED_ORIGINS": "http://localhost:3001,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008,http://localhost:3009,http://localhost:3021,https://tryrevline.com,https://www.tryrevline.com" },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false }, "redact_query_string": true, "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true } }
}
