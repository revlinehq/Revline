{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revline-web",
  "account_id": "701645e913477e567db69b11343f59d8",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "routes": [
    {
      "pattern": "tryrevline.com",
      "custom_domain": true
    },
    {
      "pattern": "editor.tryrevline.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://tryrevline.com",
    "REVLINE_CLIP_PROTOTYPE": "true",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsudHJ5cmV2bGluZS5jb20k",
    "NEXT_PUBLIC_CONVEX_SITE_URL": "https://different-gnu-398.convex.site",
    "NEXT_PUBLIC_CONVEX_URL": "https://different-gnu-398.convex.cloud",
    "MEDIA_WORKER_URL": "https://revline-editor-media-production.makaradze98-s.workers.dev",
    "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/campaigns",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/campaigns",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up"
  }
}
